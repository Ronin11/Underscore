# Copy to ~/.config/underscore/worker.env and fill in. Keep it private:
# chmod 600. The tokens here are the worker's own, not anyone's login.

# The map server, and the token set in its compose .env.
UNDERSCORE_MAPS_URL=http://10.0.0.51:8790   # the media container, port 8790
UNDERSCORE_WORKER_TOKEN=

# Audiobookshelf, with an API key made for the worker under
# Settings > API Keys. It only needs to read books.
UNDERSCORE_ABS_URL=http://10.0.0.51:13378
UNDERSCORE_ABS_TOKEN=

# Navidrome or another Subsonic server, with an account that can see the
# music maps should use.
UNDERSCORE_SUBSONIC_URL=http://navidrome.home:4533
UNDERSCORE_SUBSONIC_USER=
UNDERSCORE_SUBSONIC_PASSWORD=

# Where the servers' folders are on this machine. Without these, the
# worker downloads what it reads through the servers instead.
# Audiobookshelf path prefix=local folder, separated by ";".
UNDERSCORE_BOOK_PATHS=/audiobooks=/mnt/nas-media/Audiobooks
# Navidrome's music folder here; song paths are relative to it.
UNDERSCORE_MUSIC_ROOT=/mnt/nas-media/Music
# Score only with songs under these folders, comma separated. Empty uses
# every song. Songs a book names are found anywhere.
UNDERSCORE_MUSIC_ONLY=

# The local model, and the speech and music models.
UNDERSCORE_OLLAMA_URL=http://localhost:11434
UNDERSCORE_OLLAMA_MODEL=qwen3:30b-a3b
UNDERSCORE_WHISPER_MODEL=distil-large-v3
UNDERSCORE_CLAP_MODEL=laion/larger_clap_general
UNDERSCORE_DEVICE=cuda
