<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- The watch's "asleep" state from Health Services. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <application
        android:icon="@drawable/ic_launcher"
        android:label="underscore sleep"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Useless without the phone app, which plays the book. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".WatchActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Services calls this when the wearer's state changes,
             even while the app is closed. -->
        <service
            android:name=".AsleepService"
            android:exported="true"
            android:permission="com.google.android.wearable.healthservices.permission.PASSIVE_DATA_BINDING" />

        <!-- The phone asking how things stand, from its setup screen. -->
        <service
            android:name=".PhoneListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/underscore" />
            </intent-filter>
        </service>
    </application>
</manifest>
