<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to the listener's own Audiobookshelf server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Books kept offline wait for Wi-Fi when the setting says so. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scanning a music folder by path for a map. Audio files only. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Google's sleep guess on the phone, when that sleep source is on. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
    <!-- A short buzz when a shake undoes a sleep stop. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".UnderscoreApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Underscore">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <activity
            android:name=".BooksActivity"
            android:exported="false"
            android:label="Library"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name=".ConnectionsActivity"
            android:exported="false"
            android:label="Connections" />

        <activity
            android:name=".BookActivity"
            android:exported="false"
            android:label="Book"
            android:parentActivityName=".BooksActivity" />

        <activity
            android:name=".DebugActivity"
            android:exported="false"
            android:label="Debug"
            android:parentActivityName=".SettingsActivity" />

        <!-- Where the browser returns after an Audiobookshelf single sign-on.
             Ours first; the stock address is what servers allow by default. -->
        <activity
            android:name=".SignInReturnActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="underscore" android:host="oauth" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="audiobookshelf" android:host="oauth" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Sleep readings from Google's sleep API, and other apps saying the
             listener is asleep. Exported so any app can send the broadcast;
             it does nothing unless the listener turned that source on. -->
        <receiver
            android:name=".SleepReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.ronin11.underscore.ASLEEP" />
            </intent-filter>
        </receiver>

        <!-- The watch app saying the listener fell asleep, or answering the
             setup screen. Only an app with this id and key can reach it. -->
        <service
            android:name=".WatchListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/underscore" />
            </intent-filter>
        </service>

        <!-- Hands a saved bug report to whatever app the user shares it with. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="io.github.ronin11.underscore.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
